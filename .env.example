# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creator_commerce?schema=public"
# Direct (non-pooled) connection, used only by `prisma migrate`. Required on
# hosted Postgres such as Neon or Supabase; leave equal to DATABASE_URL locally.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/creator_commerce?schema=public"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Storage (local driver for Phase 1; s3 / r2 / supabase come later)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# ---------------------------------------------------------------------------
# Payments (abstraction only in Phase 1 — no real processing)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=manual

# ---------------------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_NAME=Storefront Studio
